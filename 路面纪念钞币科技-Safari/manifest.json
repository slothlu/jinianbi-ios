{
  "manifest_version": 3,
  "name": "路面纪念钞币科技",
  "version": "1.0.2",
  "description": "网页表单填写助手、多用户系统、智能ocr识别、自动填写、自动选择网点、自动填写验证码",
  "action": {
    "default_popup": "popup.html",
    "default_title": "路面纪念钞币科技"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.qora.top/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["ocrInject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "banks/BankMatch.js",
        "banks/sx_common.js",
        "banks/sx_branch_finder.js",
        "banks/sx_abc.js",
        "banks/sx_boc.js",
        "banks/sx_ccb.js",
        "banks/sx_psbc.js",
        "banks/sx_icbc.js",
        "content.js",
        "mobile_touch_patch.js"
      ],
      "run_at": "document_end"
    }
  ]
}

